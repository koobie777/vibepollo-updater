def installed_version() -> str | None:
    """Return installed pacman version of `vibepollo`, or None if not installed."""
    try:
        r = subprocess.run(
            ["pacman", "-Q", "vibepollo"],
            capture_output=True, text=True, timeout=5, check=False, shell=False,
        )
        if r.returncode == 0 and r.stdout.strip():
            parts = r.stdout.strip().split()
            return parts[1] if len(parts) >= 2 else parts[0]
    except OSError:
        pass
    return None


def service_status() -> str:
    """Return systemd status summary for Vibepollo controller & host units."""
    try:
        r1 = subprocess.run(
            ["systemctl", "is-active", "vibepollo-session-controller.service"],
            capture_output=True, text=True, timeout=5, check=False, shell=False,
        )
        r2 = subprocess.run(
            ["systemctl", "is-active", "vibepollo.service"],
            capture_output=True, text=True, timeout=5, check=False, shell=False,
        )
        ctrl = r1.stdout.strip() or "unknown"
        svc = r2.stdout.strip() or "unknown"
        return f"controller={ctrl} · host={svc}"
    except OSError:
        return "unknown"


def pick_arch_asset(release: dict[str, Any]) -> dict[str, Any] | None:
    """Find the official x86_64 Arch package asset and its SHA-256 digest."""
    for asset in release.get("assets") or []:
        name = str(asset.get("name") or "")
        if PKG_RE.match(name):
            digest = str(asset.get("digest") or "")
            sha256 = digest.split(":", 1)[1].strip().lower() if digest.startswith("sha256:") else ""
            return {
                "name": name,
                "url": str(asset.get("browser_download_url") or ""),
                "size": int(asset.get("size") or 0),
                "sha256": sha256,
            }
    return None


def classify_channel(release: dict[str, Any]) -> str:
    """Classify a GitHub release into 'stable', 'beta', 'nightly', or 'draft'."""
    if release.get("draft"):
        return "draft"
    if not release.get("prerelease"):
        return "stable"
    text = f"{release.get('tag_name', '')} {release.get('name', '')}".lower()
    if "beta" in text or re.search(r"(^|[^a-z])rc[0-9.]*", text):
        return "beta"
    if "nightly" in text:
        return "nightly"
    return "beta"


CHANNELS = ("stable", "prerelease", "beta", "nightly")


def release_entry(rel: dict[str, Any]) -> dict[str, Any] | None:
    """Normalise one GitHub release; None for drafts and releases without an Arch package."""
    if not isinstance(rel, dict) or rel.get("draft"):
        return None
    asset = pick_arch_asset(rel)
    if not asset:
        return None
    return {
        "channel": classify_channel(rel),
        "prerelease": bool(rel.get("prerelease")),
        "tag": str(rel.get("tag_name") or ""),
        "name": str(rel.get("name") or rel.get("tag_name") or ""),
        "published_at": str(rel.get("published_at") or ""),
        "html_url": str(rel.get("html_url") or ""),
        "notes": str(rel.get("body") or "").strip()[:2000],
        "asset": asset,
    }


def parse_releases(releases: list[dict[str, Any]], *, include_prereleases: bool = True) -> list[dict[str, Any]]:
    """Every installable release, newest first, pre-releases included unless asked not to."""
    out = [e for e in (release_entry(r) for r in releases) if e]
    if not include_prereleases:
        out = [e for e in out if not e["prerelease"]]
    out.sort(key=lambda e: e["published_at"], reverse=True)
    return out


def find_release(releases: list[dict[str, Any]], tag: str) -> dict[str, Any] | None:
    """Match a tag exactly, or with a leading 'v' added or dropped."""
    want = tag.strip().lower().removeprefix("v")
    for e in parse_releases(releases):
        if e["tag"].lower().removeprefix("v") == want:
            return e
    return None


def parse_channels(releases: list[dict[str, Any]]) -> dict[str, dict[str, Any] | None]:
    """Latest installable release per channel. 'prerelease' is the newest pre-release of any kind."""
    channels: dict[str, dict[str, Any] | None] = {k: None for k in CHANNELS}
    for e in parse_releases(releases):
        if e["prerelease"] and channels["prerelease"] is None:
            channels["prerelease"] = dict(e, channel="prerelease")
        ch = e["channel"]
        if ch in channels and channels[ch] is None:
            channels[ch] = e
    return channels


def fetch_releases(timeout: float = 12.0) -> list[dict[str, Any]]:
    """Fetch the latest 100 raw releases from the GitHub REST API (no auth required)."""
    req = urllib.request.Request(
        RELEASES_API,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": f"vibepollo-updater/{__version__}",
        },
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        releases = json.loads(resp.read().decode("utf-8", "replace"))
    if not isinstance(releases, list):
        raise ValueError("unexpected GitHub releases response")
    return releases


def fetch_channels(timeout: float = 12.0) -> dict[str, dict[str, Any] | None]:
    return parse_channels(fetch_releases(timeout))


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def prune_cache(cache_dir: Path = CACHE_DIR, keep_path: Path | None = None, max_cached: int = MAX_CACHED) -> None:
    if not cache_dir.is_dir():
        return
    pkgs = sorted(
        [p for p in cache_dir.iterdir() if p.is_file() and PKG_RE.match(p.name)],
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    kept = 0
    for p in pkgs:
        if keep_path and p.resolve() == keep_path.resolve():
            kept += 1
            continue
        if kept < max_cached:
            kept += 1
        else:
            try:
                p.unlink()
            except OSError:
                pass


def list_cached_packages(cache_dir: Path = CACHE_DIR) -> list[Path]:
    if not cache_dir.is_dir():
        return []
    return sorted(
        [p for p in cache_dir.iterdir() if p.is_file() and PKG_RE.match(p.name)],
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )


def verify_file_sha256(path: Path, expected_sha256: str) -> str:
    """Compute SHA-256 and raise ValueError if expected digest is provided and mismatches."""
    actual = sha256_file(path)
    exp = (expected_sha256 or "").strip().lower()
    if exp and actual != exp:
        raise ValueError(f"SHA-256 mismatch! expected {exp[:16]}..., got {actual[:16]}...")
    return actual


def download_and_verify(rel: dict[str, Any], *, cache_dir: Path = CACHE_DIR, progress_cb=None) -> Path:
    cache_dir.mkdir(parents=True, exist_ok=True)
    asset = rel["asset"]
    dest = cache_dir / asset["name"]
    expected = asset.get("sha256") or ""

    if dest.is_file() and expected and sha256_file(dest) == expected:
        if progress_cb:
            progress_cb(100, f"Verified cached package {dest.name} (SHA-256 OK)")
        return dest

    url = asset["url"]
    if not url.startswith("https://"):
        raise ValueError(f"Refusing non-HTTPS download URL: {url!r}")

    tmp = dest.with_suffix(dest.suffix + ".part")
    req = urllib.request.Request(url, headers={"User-Agent": f"vibepollo-updater/{__version__}"})
    total = int(asset.get("size") or 0)
    done = 0
    last_pct = -1
    with urllib.request.urlopen(req, timeout=60) as resp, tmp.open("wb") as out:
        if not total:
            total = int(resp.headers.get("Content-Length") or 0)
        while True:
            chunk = resp.read(256 * 1024)
            if not chunk:
                break
            out.write(chunk)
            done += len(chunk)
            if progress_cb and total > 0:
                pct = int(min(99, (done * 100) // total))
                if pct != last_pct:
                    last_pct = pct
                    progress_cb(pct, f"Downloading {dest.name}: {done / (1024*1024):.1f} / {total / (1024*1024):.1f} MiB")

    try:
        actual = verify_file_sha256(tmp, expected)
    except ValueError:
        tmp.unlink(missing_ok=True)
        raise
    tmp.replace(dest)
    prune_cache(cache_dir=cache_dir, keep_path=dest)
    if progress_cb:
        progress_cb(100, f"Verified {dest.name} (SHA-256 {actual[:16]}...)")
    return dest


def parse_safe_vibepollo_conflicts(pacman_output: str) -> list[str]:
    """Extract conflicting file paths ONLY if EVERY conflict is a safe vibepollo/vibeshine path.

    Returns an empty list if there are no conflicts or if any conflicting path is outside
    the strict `/usr/{lib,bin,share,libexec}/...vibepollo|vibeshine...` allowlist.
    """
    paths: list[str] = []
    for raw_line in (pacman_output or "").splitlines():
        line = raw_line.strip()
        m = CONFLICT_LINE_RE.match(line)
        if m:
            p = m.group(1)
            if ".." in p or not SAFE_OVERWRITE_PATH_RE.fullmatch(p):
                return []
            if p not in paths:
                paths.append(p)
        elif "exists in filesystem" in line:
            # Another package or non-vibepollo conflict line: fail closed
            return []
    return paths


def filter_unowned_conflicts(paths: list[str]) -> list[str]:
    """Return paths ONLY if every single path is confirmed unowned by pacman (`pacman -Qo` fails)."""
    if not paths:
        return []
    for p in paths:
        try:
            r = subprocess.run(
                ["pacman", "-Qo", p],
                capture_output=True, text=True, timeout=5, check=False, shell=False,
            )
            if r.returncode == 0:
                return []
        except OSError:
            return []
    return list(paths)


def install_package(
    pkg_path: Path,
    *,
    use_pkexec: bool = True,
    overwrite_paths: list[str] | None = None,
) -> tuple[int, str]:
    if not pkg_path.is_file():
        return 2, f"Package not found: {pkg_path}"
    elevator = shutil.which("pkexec") if use_pkexec else shutil.which("sudo")
    if not elevator:
        elevator = shutil.which("sudo") or shutil.which("pkexec")
    if not elevator:
        return 2, "Neither pkexec nor sudo was found on PATH."
    cmd = [elevator, "pacman", "-U", "--noconfirm"]
    for p in overwrite_paths or []:
        if ".." not in p and SAFE_OVERWRITE_PATH_RE.fullmatch(p):
            cmd.extend(["--overwrite", p.lstrip("/")])
    cmd.append(str(pkg_path))
    r = subprocess.run(cmd, capture_output=True, text=True, check=False, shell=False)
    out = (r.stdout or "") + ("\n" + r.stderr if r.stderr else "")
    return r.returncode, out.strip()


def cli_check(as_json: bool = False) -> int:
    cur = installed_version()
    svc = service_status()
    raw = fetch_releases()
    ch = parse_channels(raw)
    cached = [p.name for p in list_cached_packages()]
    payload = {
        "installed": cur,
        "service": svc,
        "upstream": f"https://github.com/{REPO}",
        "channels": {
            k: (None if v is None else {
                "tag": v["tag"],
                "name": v["name"],
                "published_at": v["published_at"],
                "asset": v["asset"]["name"],
                "size_mb": round(v["asset"]["size"] / (1024 * 1024), 1),
                "sha256": v["asset"]["sha256"],
            })
            for k, v in ch.items()
        },
        "releases": [
            {"tag": e["tag"], "prerelease": e["prerelease"], "channel": e["channel"],
             "published_at": e["published_at"], "asset": e["asset"]["name"], "sha256": e["asset"]["sha256"]}
            for e in parse_releases(raw)
        ],
        "cached_rollbacks": cached,
    }
    if as_json:
        print(json.dumps(payload, indent=2))
        return 0
    print(f"Vibepollo Installed : {cur or 'NOT INSTALLED'} ({svc})")
    print(f"Upstream Repo       : https://github.com/{REPO}")
    for key in CHANNELS:
        v = ch.get(key)
        if not v:
            print(f"  {key:<10}: (no dedicated {key} release posted right now)")
        else:
            sz = v["asset"]["size"] / (1024 * 1024)
            print(f"  {key:<10}: {v['tag']:<12} [{v['name']}]  ({v['published_at'][:10]}, {sz:.1f} MiB)")
    print("Older and specific versions: vibepollo-updater --list")
    if cached:
        print(f"Cached for rollback : {', '.join(cached)}")
    return 0


def cli_list(*, include_prereleases: bool = True) -> int:
    cur = installed_version()
    rows = parse_releases(fetch_releases(), include_prereleases=include_prereleases)
    print(f"{'TAG':<44} {'KIND':<11} {'DATE':<10}  SIZE")
    for e in rows:
        kind = e["channel"] if e["prerelease"] else "stable"
        mark = "  <- installed" if cur and cur.split("-")[0] == e["asset"]["name"].split("-")[1] else ""
        print(f"{e['tag']:<44} {kind:<11} {e['published_at'][:10]}  {e['asset']['size'] / (1024 * 1024):.1f} MiB{mark}")
    print(f"\n{len(rows)} releases. Install one: vibepollo-updater --install-version <TAG>")
    return 0


def launch_gui(*, smoke_offscreen: bool = False) -> int:
    try:
        from PySide6.QtCore import QThread, Qt, Signal
        from PySide6.QtWidgets import (
            QApplication,
            QCheckBox,
            QComboBox,
            QFrame,
            QHBoxLayout,
            QLabel,
            QMainWindow,
            QMessageBox,
            QPlainTextEdit,
            QProgressBar,
            QPushButton,
            QRadioButton,
            QVBoxLayout,
            QWidget,
        )
    except ImportError:
        print("PySide6 is required for GUI mode (install `pyside6` via pacman). CLI mode (`--check`, `--update`) needs no GUI.", file=sys.stderr)
        return 2

    app = QApplication.instance() or QApplication(["vibepollo-updater"])
    app.setStyleSheet(DARK_STYLESHEET)

    class FetchWorker(QThread):
        done = Signal(object, str)

        def __init__(self, parent=None) -> None:
            super().__init__(parent)

        def run(self) -> None:
            try:
                self.done.emit(fetch_releases(), "")
            except Exception as exc:
                self.done.emit(None, str(exc))

    class InstallWorker(QThread):
        progress = Signal(int, str)
        finished_install = Signal(int, str, object)

        def __init__(
            self,
            rel: dict[str, Any] | None,
            local_pkg: Path | None = None,
            overwrite_paths: list[str] | None = None,
            parent=None,
        ) -> None:
            super().__init__(parent)
            self._rel = rel
            self._local_pkg = local_pkg
            self._overwrite_paths = overwrite_paths

        def run(self) -> None:
            pkg = self._local_pkg
            try:
                if pkg is not None:
                    self.progress.emit(50, f"Installing cached package {pkg.name}...")
                else:
                    assert self._rel is not None
                    pkg = download_and_verify(self._rel, progress_cb=lambda p, m: self.progress.emit(p, m))
                self.progress.emit(100, f"Running pacman -U {pkg.name} (authenticate if prompted)...")
                rc, out = install_package(pkg, use_pkexec=True, overwrite_paths=self._overwrite_paths)
                self.finished_install.emit(rc, out, pkg)
            except Exception as exc:
                self.finished_install.emit(1, str(exc), pkg)

