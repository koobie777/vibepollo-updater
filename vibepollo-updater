def install_vigembus(setup: Path, *, silent: bool = False) -> tuple[int, str]:
    """Run ViGEmBus v1.22.0 installer elevated (one UAC prompt). Returns (exit code, report)."""
    if not WINDOWS:
        return 2, "ViGEmBus is a Windows-only gamepad driver."
    if not setup.is_file():
        return 2, f"ViGEmBus installer not found: {setup}"
    before = vigembus_status()
    work = Path(tempfile.mkdtemp(prefix="vibepollo-vigem-"))
    script, result = work / "install-vigem.ps1", work / "result.txt"
    script.write_text(WIN_VIGEM_PS, encoding="utf-8")
    silent_flag = " -Silent" if silent else ""
    args = f'-NoProfile -ExecutionPolicy Bypass -File "{script}" -Setup "{setup}" -Result "{result}"{silent_flag}'
    cmd = ["powershell", "-NoProfile", "-Command",
           f"Start-Process powershell -Verb RunAs -Wait -WindowStyle Hidden -ArgumentList {_ps_quote(args)}"]
    r = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if not result.is_file():
        shutil.rmtree(work, ignore_errors=True)
        return 1223, "Cancelled: Windows did not run the ViGEmBus installer (UAC declined?).\n" + (r.stderr or "").strip()
    text = result.read_text(encoding="utf-8", errors="replace").strip()
    shutil.rmtree(work, ignore_errors=True)
    rc = int(text) if text.lstrip("-").isdigit() else 1
    after = vigembus_status()
    lines = [
        f"ViGEmBus installer {setup.name} exited {rc}.",
        f"ViGEmBus now: {after['summary']}",
    ]
    if rc == 3010:
        lines.append("Windows restart required to finish ViGEmBus driver setup.")
    if before.get("needs_update") and after.get("needs_update"):
        lines.append("Note: upstream v1.22.0 in-place upgrades can require running the ViGEmBus installer a second time.")
    return rc, "\n".join(lines)


def install_package(
    pkg_path: Path,
    *,
    use_pkexec: bool = True,
    overwrite_paths: list[str] | None = None,
    silent: bool = False,
) -> tuple[int, str]:
    if not pkg_path.is_file():
        return 2, f"Package not found: {pkg_path}"
    if WINDOWS:
        return install_windows(pkg_path, silent=silent)
    elevator = shutil.which("pkexec") if use_pkexec else shutil.which("sudo")
    if not elevator:
        elevator = shutil.which("sudo") or shutil.which("pkexec")
    if not elevator:
        return 2, "Neither pkexec nor sudo was found on PATH."
    cmd = [elevator, "pacman", "-U", "--noconfirm"]
    for p in overwrite_paths or []:
        if ".." not in p and SAFE_OVERWRITE_PATH_RE.fullmatch(p):
            cmd.extend(["--overwrite", p.lstrip("/")])
    cmd.append(str(pkg_path))
    r = subprocess.run(cmd, capture_output=True, text=True, check=False, shell=False)
    out = (r.stdout or "") + ("\n" + r.stderr if r.stderr else "")
    return r.returncode, out.strip()


