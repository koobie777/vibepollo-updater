__version__ = "1.1.0"

REPO = "Nonary/Vibepollo"
RELEASES_API = f"https://api.github.com/repos/{REPO}/releases?per_page=100"
CACHE_DIR = Path.home() / ".cache/vibepollo-updater"
PKG_RE = re.compile(r"^vibepollo-.+-x86_64\.pkg\.tar(\.zst|\.xz)?$", re.IGNORECASE)
CONFLICT_LINE_RE = re.compile(r"^vibepollo:\s+(/\S+)\s+exists in filesystem\b")
SAFE_OVERWRITE_PATH_RE = re.compile(
    r"^/usr/(?:lib|bin|share|libexec)/[A-Za-z0-9_./-]*(?:vibepollo|vibeshine)[A-Za-z0-9_./-]*$",
    re.IGNORECASE,
)
MAX_CACHED = 3
ARCH_FAMILY = frozenset({"arch", "cachyos", "endeavouros", "manjaro", "steamos"})


def linux_family(os_release_text: str | None = None) -> str:
    """Return 'arch' when os-release names an Arch-family distro, else 'other'."""
    if os_release_text is None:
        try:
            os_release_text = Path("/etc/os-release").read_text(encoding="utf-8")
        except OSError:
            return "other"
    tokens: set[str] = set()
    for line in os_release_text.splitlines():
        if "=" not in line or line.startswith("#"):
            continue
        key, val = line.split("=", 1)
        if key.strip() not in {"ID", "ID_LIKE", "NAME"}:
            continue
        tokens.update(re.split(r"[^a-z0-9]+", val.strip().strip("'\"").lower()))
    if tokens & ARCH_FAMILY:
        return "arch"
    return "other"

