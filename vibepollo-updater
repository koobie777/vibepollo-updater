def matches_installed_release(installed: str | None, entry: dict[str, Any]) -> bool:
    """True when the installed version string matches a release entry (works on both Windows and Linux)."""
    if not installed:
        return False
    cur_num = numeric_version(installed)
    rel_num = numeric_version(entry.get("tag"))
    if cur_num is not None and rel_num is not None:
        return cur_num == rel_num
    cur_clean = installed.strip().lower().removeprefix("v").split("-", 1)[0]
    tag_clean = str(entry.get("tag") or "").strip().lower().removeprefix("v")
    if cur_clean == tag_clean:
        return True
    asset_name = str((entry.get("asset") or {}).get("name") or "")
    parts = asset_name.split("-")
    return len(parts) >= 2 and cur_clean == parts[1].lower()


def cli_list(*, include_prereleases: bool = True) -> int:
    cur = installed_version()
    rows = parse_releases(fetch_releases(), include_prereleases=include_prereleases)
    print(f"{'TAG':<44} {'KIND':<11} {'DATE':<10}  SIZE")
    for e in rows:
        kind = e["channel"] if e["prerelease"] else "stable"
        mark = "  <- installed" if matches_installed_release(cur, e) else ""
        print(f"{e['tag']:<44} {kind:<11} {e['published_at'][:10]}  {e['asset']['size'] / (1024 * 1024):.1f} MiB{mark}")
    print(f"\n{len(rows)} releases. Install one: vibepollo-updater --install-version <TAG>")
    return 0


