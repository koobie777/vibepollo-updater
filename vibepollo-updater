def platform_supported() -> bool:
    """Windows, or an Arch-family Linux: the two places upstream publishes an installer."""
    return WINDOWS or linux_family() == "arch"


def windows_installs() -> list[dict[str, Any]]:
    """Every 'Vibepollo' entry in Windows' installed-programs list."""
    if not WINDOWS:
        return []
    import winreg  # noqa: PLC0415 - Windows only

    out: list[dict[str, Any]] = []
    roots = (
        (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall"),
        (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall"),
        (winreg.HKEY_CURRENT_USER, r"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall"),
    )
    for hive, path in roots:
        try:
            parent = winreg.OpenKey(hive, path)
        except OSError:
            continue
        with parent:
            for i in range(winreg.QueryInfoKey(parent)[0]):
                try:
                    sub = winreg.EnumKey(parent, i)
                    with winreg.OpenKey(parent, sub) as k:
                        vals: dict[str, Any] = {}
                        for name in ("DisplayName", "DisplayVersion", "UninstallString", "InstallLocation"):
                            try:
                                vals[name] = str(winreg.QueryValueEx(k, name)[0])
                            except OSError:
                                vals[name] = ""
                        try:
                            vals["SystemComponent"] = int(winreg.QueryValueEx(k, "SystemComponent")[0]) == 1
                        except (OSError, ValueError, TypeError):
                            vals["SystemComponent"] = False
                except OSError:
                    continue
                if vals["DisplayName"].strip().lower() != "vibepollo":
                    continue
                out.append({
                    "key": sub,
                    "version": vals["DisplayVersion"],
                    "msi": "msiexec" in vals["UninstallString"].lower(),
                    "system_component": bool(vals["SystemComponent"]),
                    "uninstall": vals["UninstallString"],
                    "location": vals["InstallLocation"],
                })
    return out


def summarize_windows_installs(entries: list[dict[str, Any]]) -> tuple[str | None, bool]:
    """Return (version, stacked). A normal install has 1 visible bootstrapper entry plus 1 hidden MSI (SystemComponent=1)."""
    if not entries:
        return None, False
    visible = [e for e in entries if not e.get("system_component")]
    msi_count = sum(1 for e in entries if e.get("msi"))
    stacked = len(visible) > 1 or msi_count > 1
    pool = visible or entries
    vers = [str(e.get("version") or "").strip() for e in pool if str(e.get("version") or "").strip()]
    if not vers:
        return None, stacked
    return max(vers, key=lambda v: numeric_version(v) or (0, 0, 0)), stacked


def installed_version() -> str | None:
    """Return the installed Vibepollo version (pacman on Linux, the programs list on Windows), or None."""
    if WINDOWS:
        ver, _ = summarize_windows_installs(windows_installs())
        return ver
    try:
        r = subprocess.run(
            ["pacman", "-Q", "vibepollo"],
            capture_output=True, text=True, timeout=5, check=False, shell=False,
        )
        if r.returncode == 0 and r.stdout.strip():
            parts = r.stdout.strip().split()
            return parts[1] if len(parts) >= 2 else parts[0]
    except OSError:
        pass
    return None


def summarize_vigembus(version: str | None, service_state: str) -> dict[str, Any]:
    """Summarize Windows ViGEmBus driver state vs final release v1.22.0."""
    ver = (version or "").strip() or None
    svc = (service_state or "unknown").strip().lower()
    installed = bool(ver) or svc in ("running", "stopped")
    cur_num = numeric_version(ver) if ver else None
    target_num = numeric_version(VIGEMBUS_VERSION) or (1, 22, 0)
    needs_update = bool(installed and cur_num is not None and cur_num < target_num)
    if not installed:
        summary = f"not installed (v{VIGEMBUS_VERSION} available)"
    elif needs_update:
        summary = f"{ver} ({svc}) · v{VIGEMBUS_VERSION} available (in-place upgrade may need running setup twice)"
    elif ver:
        summary = f"{ver} ({svc})"
    else:
        summary = f"installed ({svc})"
    return {
        "installed": installed,
        "version": ver,
        "service": svc,
        "target": VIGEMBUS_VERSION,
        "needs_update": needs_update,
        "summary": summary,
        "release_url": VIGEMBUS_RELEASE_URL,
    }


def vigembus_status() -> dict[str, Any]:
    """Detect Windows ViGEmBus v1.x (separate from Nefarius VirtualPad G2) and its driver service."""
    if not WINDOWS:
        return {
            "installed": False,
            "version": None,
            "service": "n/a",
            "target": VIGEMBUS_VERSION,
            "needs_update": False,
            "summary": "Windows only",
            "release_url": VIGEMBUS_RELEASE_URL,
        }
    import winreg  # noqa: PLC0415 - Windows only

    version: str | None = None
    # 1. Official ViGEmBus key named in nefarius/ViGEmBus v1.22.0 release metadata
    for hive in (winreg.HKEY_LOCAL_MACHINE, winreg.HKEY_CURRENT_USER):
        for subkey in (
            r"SOFTWARE\Nefarius Software Solutions e.U.\ViGEm Bus Driver",
            r"SOFTWARE\WOW6432Node\Nefarius Software Solutions e.U.\ViGEm Bus Driver",
        ):
            try:
                with winreg.OpenKey(hive, subkey) as k:
                    v = str(winreg.QueryValueEx(k, "Version")[0]).strip()
                    if v:
                        version = v
                        break
            except OSError:
                continue
        if version:
            break

    # 2. Fallback: Uninstall entries for ViGEmBus v1.x (explicitly skip Nefarius VirtualPad G2)
    if not version:
        for hive, path in (
            (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall"),
            (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall"),
        ):
            try:
                parent = winreg.OpenKey(hive, path)
            except OSError:
                continue
            with parent:
                for i in range(winreg.QueryInfoKey(parent)[0]):
                    try:
                        sub = winreg.EnumKey(parent, i)
                        with winreg.OpenKey(parent, sub) as k:
                            dn = str(winreg.QueryValueEx(k, "DisplayName")[0]).strip()
                            low = dn.lower()
                            if "virtualpad" in low or "g2" in low:
                                continue
                            if "vigem" in low or "virtual gamepad emulation bus driver" in low:
                                dv = str(winreg.QueryValueEx(k, "DisplayVersion")[0]).strip()
                                if dv:
                                    version = dv
                                    break
                    except OSError:
                        continue
            if version:
                break

    svc_state = "unknown"
    try:
        r = subprocess.run(["sc", "query", "ViGEmBus"], capture_output=True, text=True, timeout=5, check=False)
        m = re.search(r"STATE\s*:\s*\d+\s+(\w+)", r.stdout or "")
        svc_state = m.group(1).lower() if m else "not installed"
    except OSError:
        svc_state = "unknown"
    return summarize_vigembus(version, svc_state)


def service_status() -> str:
    """Return systemd status summary for Vibepollo controller & host units (the Windows service on Windows)."""
    if WINDOWS:
        try:
            r = subprocess.run(["sc", "query", WIN_SERVICE], capture_output=True, text=True, timeout=5, check=False)
        except OSError:
            return "unknown"
        m = re.search(r"STATE\s*:\s*\d+\s+(\w+)", r.stdout or "")
        state = m.group(1).lower() if m else "not installed"
        _, stacked = summarize_windows_installs(windows_installs())
        return f"{WIN_SERVICE}={state}" + (" · TWO INSTALLS REGISTERED (updates can fail)" if stacked else "")
    try:
        r1 = subprocess.run(
            ["systemctl", "is-active", "vibepollo-session-controller.service"],
            capture_output=True, text=True, timeout=5, check=False, shell=False,
        )
        r2 = subprocess.run(
            ["systemctl", "is-active", "vibepollo.service"],
            capture_output=True, text=True, timeout=5, check=False, shell=False,
        )
        ctrl = r1.stdout.strip() or "unknown"
        svc = r2.stdout.strip() or "unknown"
        return f"controller={ctrl} · host={svc}"
    except OSError:
        return "unknown"


def pick_arch_asset(release: dict[str, Any], *, windows: bool | None = None) -> dict[str, Any] | None:
    """Find this platform's official asset and its SHA-256: the x86_64 Arch package, or VibepolloSetup*.exe on Windows."""
    want = WIN_SETUP_RE if (WINDOWS if windows is None else windows) else PKG_RE
    for asset in release.get("assets") or []:
        name = str(asset.get("name") or "")
        if want.match(name):
            digest = str(asset.get("digest") or "")
            sha256 = digest.split(":", 1)[1].strip().lower() if digest.startswith("sha256:") else ""
            return {
                "name": name,
                "url": str(asset.get("browser_download_url") or ""),
                "size": int(asset.get("size") or 0),
                "sha256": sha256,
            }
    return None


def classify_channel(release: dict[str, Any]) -> str:
    """Use GitHub release status, never a suffix in the numeric version."""
    if release.get("draft"):
        return "draft"
    return "prerelease" if release.get("prerelease") else "stable"


# 'latest' may be a pre-release. Older CLI spellings remain as compatibility aliases.
CHANNELS = ("stable", "latest")
CLI_CHANNELS = CHANNELS + ("prerelease", "nightly")


def release_entry(rel: dict[str, Any], *, windows: bool | None = None) -> dict[str, Any] | None:
    """Normalise one GitHub release; None for drafts and releases without an asset for this platform."""
    if not isinstance(rel, dict):
        return None
    # Missing or malformed upstream release flags must never be guessed as "stable".
    if not isinstance(rel.get("draft"), bool) or rel["draft"]:
        return None
    if not isinstance(rel.get("prerelease"), bool):
        return None
    if not str(rel.get("tag_name") or "").strip() or not str(rel.get("published_at") or "").strip():
        return None
    asset = pick_arch_asset(rel, windows=windows)
    if not asset:
        return None
    return {
        "channel": classify_channel(rel),
        "prerelease": bool(rel.get("prerelease")),
        "tag": str(rel.get("tag_name") or ""),
        "name": str(rel.get("name") or rel.get("tag_name") or ""),
        "published_at": str(rel.get("published_at") or ""),
        "html_url": str(rel.get("html_url") or ""),
        "notes": str(rel.get("body") or "").strip()[:2000],
        "asset": asset,
    }


def parse_releases(
    releases: list[dict[str, Any]],
    *,
    include_prereleases: bool = True,
    windows: bool | None = None,
) -> list[dict[str, Any]]:
    """Every installable release, newest first, pre-releases included unless asked not to."""
    out = [e for e in (release_entry(r, windows=windows) for r in releases) if e]
    if not include_prereleases:
        out = [e for e in out if not e["prerelease"]]
    out.sort(key=lambda e: e["published_at"], reverse=True)
    return out


def find_release(
    releases: list[dict[str, Any]],
    tag: str,
    *,
    windows: bool | None = None,
) -> dict[str, Any] | None:
    """Match a tag exactly, or with a leading 'v' added or dropped."""
    want = tag.strip().lower().removeprefix("v")
    for e in parse_releases(releases, windows=windows):
        if e["tag"].lower().removeprefix("v") == want:
            return e
    return None


def parse_channels(
    releases: list[dict[str, Any]],
    *,
    windows: bool | None = None,
) -> dict[str, dict[str, Any] | None]:
    """Stable is the newest non-prerelease; Latest is the newest published package."""
    channels: dict[str, dict[str, Any] | None] = {k: None for k in CHANNELS}
    for e in parse_releases(releases, windows=windows):
        if channels["latest"] is None:
            channels["latest"] = dict(e, channel="latest")
        if not e["prerelease"] and channels["stable"] is None:
            channels["stable"] = e
    return channels


def select_channel(
    releases: list[dict[str, Any]],
    channel: str,
    *,
    windows: bool | None = None,
) -> dict[str, Any] | None:
    """Support legacy --update prerelease/nightly without relying on version suffixes."""
    if channel in ("prerelease", "nightly"):
        return next(
            (dict(e, channel=channel) for e in parse_releases(releases, windows=windows) if e["prerelease"]),
            None,
        )
    return parse_channels(releases, windows=windows).get(channel)


def numeric_version(version: str | None) -> tuple[int, int, int] | None:
    """Extract the numeric upstream version, ignoring pacman pkgrel or old suffixes."""
    match = re.match(r"^(?:\d+:)?v?(\d+)\.(\d+)\.(\d+)(?:$|[.-])", version or "", re.I)
    return tuple(int(part) for part in match.groups()) if match else None


def release_is_downgrade(installed: str | None, release: dict[str, Any]) -> bool:
    """Only warn on an unambiguous lower numeric version; never guess about old tags."""
    old = numeric_version(installed)
    new = numeric_version(release.get("tag"))
    return old is not None and new is not None and new < old


def fetch_releases(timeout: float = 12.0) -> list[dict[str, Any]]:
    """Fetch the latest 100 raw releases from the GitHub REST API (no auth required)."""
    req = urllib.request.Request(
        RELEASES_API,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": f"vibepollo-updater/{__version__}",
        },
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        releases = json.loads(resp.read().decode("utf-8", "replace"))
    if not isinstance(releases, list):
        raise ValueError("unexpected GitHub releases response")
    return releases


def fetch_channels(timeout: float = 12.0) -> dict[str, dict[str, Any] | None]:
    return parse_channels(fetch_releases(timeout))


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def cached_re(*, windows: bool | None = None) -> re.Pattern[str]:
    """Names of cached installers: pacman packages on Linux, tagged VibepolloSetup-<tag>.exe copies on Windows."""
    return WIN_CACHED_RE if (WINDOWS if windows is None else windows) else PKG_RE


def cached_name(rel: dict[str, Any], *, windows: bool | None = None) -> str:
    """Upstream calls every Windows build VibepolloSetup.exe, so the cached copy carries the tag."""
    name = rel["asset"]["name"]
    is_win = WINDOWS if windows is None else windows
    if is_win and WIN_SETUP_RE.match(name):
        tag = re.sub(r"[^0-9A-Za-z.+-]", "_", str(rel.get("tag") or "unknown"))
        return f"VibepolloSetup-{tag}.exe"
    return name


def prune_cache(
    cache_dir: Path = CACHE_DIR,
    keep_path: Path | None = None,
    max_cached: int = MAX_CACHED,
    *,
    windows: bool | None = None,
) -> None:
    if not cache_dir.is_dir():
        return
    pat = cached_re(windows=windows)
    pkgs = sorted(
        [p for p in cache_dir.iterdir() if p.is_file() and pat.match(p.name)],
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    kept = 0
    for p in pkgs:
        if keep_path and p.resolve() == keep_path.resolve():
            kept += 1
            continue
        if kept < max_cached:
            kept += 1
        else:
            try:
                p.unlink()
            except OSError:
                pass


def list_cached_packages(cache_dir: Path = CACHE_DIR, *, windows: bool | None = None) -> list[Path]:
    if not cache_dir.is_dir():
        return []
    pat = cached_re(windows=windows)
    return sorted(
        [p for p in cache_dir.iterdir() if p.is_file() and pat.match(p.name)],
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )


def verify_file_sha256(path: Path, expected_sha256: str) -> str:
    """Compute SHA-256 and raise ValueError if expected digest is provided and mismatches."""
    actual = sha256_file(path)
    exp = (expected_sha256 or "").strip().lower()
    if exp and actual != exp:
        raise ValueError(f"SHA-256 mismatch! expected {exp[:16]}..., got {actual[:16]}...")
    return actual


def download_and_verify(rel: dict[str, Any], *, cache_dir: Path = CACHE_DIR, progress_cb=None) -> Path:
    cache_dir.mkdir(parents=True, exist_ok=True)
    asset = rel["asset"]
    dest = cache_dir / cached_name(rel)
    expected = str(asset.get("sha256") or "").lower()
    if not re.fullmatch(r"[0-9a-f]{64}", expected):
        raise ValueError("Official release SHA-256 is missing or invalid; refusing to install.")

    if dest.is_file() and expected and sha256_file(dest) == expected:
        if progress_cb:
            progress_cb(100, f"Verified cached package {dest.name} (SHA-256 OK)")
        return dest

    url = asset["url"]
    if not url.startswith("https://"):
        raise ValueError(f"Refusing non-HTTPS download URL: {url!r}")

    tmp = dest.with_suffix(dest.suffix + ".part")
    req = urllib.request.Request(url, headers={"User-Agent": f"vibepollo-updater/{__version__}"})
    total = int(asset.get("size") or 0)
    done = 0
    last_pct = -1
    with urllib.request.urlopen(req, timeout=60) as resp, tmp.open("wb") as out:
        if not total:
            total = int(resp.headers.get("Content-Length") or 0)
        while True:
            chunk = resp.read(256 * 1024)
            if not chunk:
                break
            out.write(chunk)
            done += len(chunk)
            if progress_cb and total > 0:
                pct = int(min(99, (done * 100) // total))
                if pct != last_pct:
                    last_pct = pct
                    progress_cb(pct, f"Downloading {dest.name}: {done / (1024*1024):.1f} / {total / (1024*1024):.1f} MiB")

    try:
        actual = verify_file_sha256(tmp, expected)
    except ValueError:
        tmp.unlink(missing_ok=True)
        raise
    tmp.replace(dest)
    prune_cache(cache_dir=cache_dir, keep_path=dest)
    if progress_cb:
        progress_cb(100, f"Verified {dest.name} (SHA-256 {actual[:16]}...)")
    return dest


def parse_safe_vibepollo_conflicts(pacman_output: str) -> list[str]:
    """Extract conflicting file paths ONLY if EVERY conflict is a safe vibepollo/vibeshine path.

    Returns an empty list if there are no conflicts or if any conflicting path is outside
    the strict `/usr/{lib,bin,share,libexec}/...vibepollo|vibeshine...` allowlist.
    """
    paths: list[str] = []
    for raw_line in (pacman_output or "").splitlines():
        line = raw_line.strip()
        m = CONFLICT_LINE_RE.match(line)
        if m:
            p = m.group(1)
            if ".." in p or not SAFE_OVERWRITE_PATH_RE.fullmatch(p):
                return []
            if p not in paths:
                paths.append(p)
        elif "exists in filesystem" in line:
            # Another package or non-vibepollo conflict line: fail closed
            return []
    return paths


def filter_unowned_conflicts(paths: list[str]) -> list[str]:
    """Return paths ONLY if every single path is confirmed unowned by pacman (`pacman -Qo` fails)."""
    if not paths:
        return []
    for p in paths:
        try:
            r = subprocess.run(
                ["pacman", "-Qo", p],
                capture_output=True, text=True, timeout=5, check=False, shell=False,
            )
            if r.returncode == 0:
                return []
        except OSError:
            return []
    return list(paths)


def vibepollo_desktop_icon(state: str | None = None, *, src: Path = VIBEPOLLO_DESKTOP_SRC,
                           dst: Path = VIBEPOLLO_DESKTOP_ICON) -> bool:
    """Optional Vibepollo launcher on the Desktop. state 'on'/'off' changes it; returns whether it is there."""
    if WINDOWS:
        if state in ("on", "off"):
            raise OSError("On Windows the Vibepollo installer makes its own shortcuts.")
        return False
    if state == "on":
        if not src.is_file():
            raise FileNotFoundError(f"{src} not found: install Vibepollo first")
        dst.parent.mkdir(parents=True, exist_ok=True)
        # Upstream writes "Icon=apollo.svg"; the icon spec wants the bare theme name.
        text = re.sub(r"(?m)^Icon=apollo\.svg$", "Icon=apollo", src.read_text(encoding="utf-8"))
        dst.write_text(text, encoding="utf-8")
        dst.chmod(0o755)
    elif state == "off":
        dst.unlink(missing_ok=True)
    return dst.is_file()


# Runs elevated (one UAC prompt): copy config aside, then run upstream's own installer and wait for it.
WIN_INSTALL_PS = r"""
param([string]$Setup, [string]$Cfg, [string]$Backup, [string]$Result, [switch]$Silent)
$ErrorActionPreference = 'Continue'
if (Test-Path -LiteralPath $Cfg) {
    New-Item -ItemType Directory -Force -Path $Backup | Out-Null
    robocopy $Cfg $Backup /E /B /COPY:DAT /R:1 /W:1 /NP /NFL /NDL /NJH /NJS | Out-Null
    if ($LASTEXITCODE -ge 8) { "backup-failed $LASTEXITCODE" | Set-Content -LiteralPath $Result; exit 1 }
}
if ($Silent) {
    $p = Start-Process -FilePath $Setup -ArgumentList @('/qn', '/norestart') -Wait -PassThru
} else {
    $p = Start-Process -FilePath $Setup -Wait -PassThru
}
"$($p.ExitCode)" | Set-Content -LiteralPath $Result
"""


def _ps_quote(text: str) -> str:
    return "'" + str(text).replace("'", "''") + "'"


def _recent_windows_install_log(since: float) -> Path | None:
    """Find the newest Vibepollo/Vibeshine MSI log written in %TEMP% since an install started."""
    temp_dir = Path(tempfile.gettempdir())
    candidates: list[Path] = []
    for pat in ("vibeshine_install_*.log", "vibepollo*install*.log", "vibeshine_cli*.log"):
        for p in temp_dir.glob(pat):
            try:
                if p.is_file() and p.stat().st_mtime >= since - 2:
                    candidates.append(p)
            except OSError:
                continue
    if not candidates:
        return None
    return max(candidates, key=lambda p: p.stat().st_mtime)


def install_windows(setup: Path, *, silent: bool = False) -> tuple[int, str]:
    """Back up config, then run VibepolloSetup.exe elevated and wait. Returns (exit code, report)."""
    started = time.time()
    backup = CONFIG_BACKUP_DIR / time.strftime("%Y%m%d-%H%M%S")
    work = Path(tempfile.mkdtemp(prefix="vibepollo-updater-"))
    script, result = work / "install.ps1", work / "result.txt"
    script.write_text(WIN_INSTALL_PS, encoding="utf-8")
    silent_flag = " -Silent" if silent else ""
    args = (f'-NoProfile -ExecutionPolicy Bypass -File "{script}" -Setup "{setup}" '
            f'-Cfg "{WIN_INSTALL_DIR / "config"}" -Backup "{backup}" -Result "{result}"{silent_flag}')
    cmd = ["powershell", "-NoProfile", "-Command",
           f"Start-Process powershell -Verb RunAs -Wait -WindowStyle Hidden -ArgumentList {_ps_quote(args)}"]
    r = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if not result.is_file():
        shutil.rmtree(work, ignore_errors=True)
        return 1223, "Cancelled: Windows did not run the installer (UAC declined?).\n" + (r.stderr or "").strip()
    text = result.read_text(encoding="utf-8", errors="replace").strip()
    shutil.rmtree(work, ignore_errors=True)
    if text.startswith("backup-failed"):
        return 1, f"Config backup failed ({text}); nothing was installed."
    rc = int(text) if text.lstrip("-").isdigit() else 1
    saved = f"Config backed up to {backup}" if backup.is_dir() else "No existing config to back up."
    lines = [
        saved,
        f"Installer {setup.name} exited {rc}. Installed now: {installed_version() or 'none'}",
    ]
    if rc == 3010:
        lines.append("Windows restart required to finish driver setup.")
    elif rc != 0:
        log = _recent_windows_install_log(started)
        if log:
            lines.append(f"Installer log: {log}")
    return rc, "\n".join(lines)


def download_and_verify_vigembus(*, cache_dir: Path = CACHE_DIR, progress_cb=None) -> Path:
    """Download ViGEmBus v1.22.0 from GitHub Releases and verify its pinned SHA-256."""
    rel = {
        "tag": VIGEMBUS_TAG,
        "asset": {
            "name": VIGEMBUS_ASSET_NAME,
            "url": VIGEMBUS_URL,
            "size": VIGEMBUS_SIZE,
            "sha256": VIGEMBUS_SHA256,
        },
    }
    cache_dir.mkdir(parents=True, exist_ok=True)
    dest = cache_dir / VIGEMBUS_ASSET_NAME
    if dest.is_file() and sha256_file(dest) == VIGEMBUS_SHA256:
        if progress_cb:
            progress_cb(100, f"Verified cached {dest.name} (SHA-256 OK)")
        return dest
    tmp = dest.with_suffix(dest.suffix + ".part")
    req = urllib.request.Request(VIGEMBUS_URL, headers={"User-Agent": f"vibepollo-updater/{__version__}"})
    total = VIGEMBUS_SIZE
    done = 0
    last_pct = -1
    with urllib.request.urlopen(req, timeout=60) as resp, tmp.open("wb") as out:
        cl = int(resp.headers.get("Content-Length") or 0)
        if cl:
            total = cl
        while True:
            chunk = resp.read(256 * 1024)
            if not chunk:
                break
            out.write(chunk)
            done += len(chunk)
            if progress_cb and total > 0:
                pct = int(min(99, (done * 100) // total))
                if pct != last_pct:
                    last_pct = pct
                    progress_cb(pct, f"Downloading {dest.name}: {done / (1024*1024):.1f} / {total / (1024*1024):.1f} MiB")
    try:
        actual = verify_file_sha256(tmp, VIGEMBUS_SHA256)
    except ValueError:
        tmp.unlink(missing_ok=True)
        raise
    tmp.replace(dest)
    if progress_cb:
        progress_cb(100, f"Verified {dest.name} (SHA-256 {actual[:16]}...)")
    return dest


WIN_VIGEM_PS = r"""
param([string]$Setup, [string]$Result, [switch]$Silent)
$ErrorActionPreference = 'Continue'
if ($Silent) {
    $p = Start-Process -FilePath $Setup -ArgumentList @('/exenoui', '/qn', '/norestart') -Wait -PassThru
} else {
