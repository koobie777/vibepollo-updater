            lay.addWidget(self.status_lbl)

            for rb in self.radios.values():
                rb.toggled.connect(self._update_preview)

            self._refresh_local_state()
            if not smoke_offscreen:
                self.refresh()

        def _refresh_local_state(self) -> None:
            cur = installed_version()
            svc = service_status()
            self.cur_lbl.setText(f"Installed: vibepollo {cur or 'NOT INSTALLED'}   |   Service: {svc}")
            if self._family != "arch":
                self.install_btn.setText("No upstream package for this distro")
                self.install_btn.setEnabled(False)
            elif cur:
                self.install_btn.setText("Download, Verify SHA-256 && Update Selected Channel")
            else:
                self.install_btn.setText("Download, Verify SHA-256 && Install Selected Channel")
            self.rollback_combo.clear()
            cached = list_cached_packages()
            for p in cached:
                self.rollback_combo.addItem(p.name, str(p))
            self.rollback_btn.setEnabled(bool(cached))

        def selected_channel(self) -> str:
            for k, rb in self.radios.items():
                if rb.isChecked():
                    return k
            return "stable"

        def _busy(self) -> bool:
            return any(worker.isRunning() for worker in self._live_workers)

        def _adopt(self, worker: QThread) -> None:
            # Parent + queued reap. Destroying a QThread on its own thread aborts
            # with "Destroyed while thread is still running" (seen 2026-11-23 02:24).
            worker.setParent(self)
            worker.setObjectName(type(worker).__name__)
            self._live_workers.append(worker)
            worker.finished.connect(self._reap_worker, Qt.ConnectionType.QueuedConnection)

        def _reap_worker(self) -> None:
            worker = self.sender()
            if not isinstance(worker, QThread):
                return
            worker.wait(60_000)
            if worker in self._live_workers:
                self._live_workers.remove(worker)
            worker.deleteLater()

        def closeEvent(self, event) -> None:
            if self._busy():
                event.ignore()
                self.status_lbl.setText("Still working. This window stays open until the job finishes.")
                return
            for worker in list(self._live_workers):
                worker.wait(5_000)
            super().closeEvent(event)

        def refresh(self) -> None:
            if self._busy():
                self.status_lbl.setText("Still working. This window stays open until the job finishes.")
                return
            self.refresh_btn.setEnabled(False)
            self.install_btn.setEnabled(False)
            self.status_lbl.setText(f"Fetching releases from github.com/{REPO}...")
            worker = FetchWorker(self)
            self._adopt(worker)
            worker.done.connect(self._on_fetched, Qt.ConnectionType.QueuedConnection)
            worker.start()

        def _on_fetched(self, releases: Any, err: str) -> None:
            self.refresh_btn.setEnabled(True)
            if err or not releases:
                self.status_lbl.setText(f"Failed to fetch releases: {err}")
                return
            self._raw_releases = releases
            channels = parse_channels(releases)
            self._channels = channels
            self._fill_versions()
            for key in CHANNELS:
                rel = channels.get(key)
                if not rel:
                    self.ch_labels[key].setText("none posted right now")
                else:
                    sz = rel["asset"]["size"] / (1024 * 1024)
                    self.ch_labels[key].setText(f"{rel['tag']}  ({rel['published_at'][:10]} · {sz:.1f} MiB)")
            self._update_preview()
            self.status_lbl.setText("Pick a channel or a specific version and click Install.")

        def _fill_versions(self) -> None:
            keep = self.version_combo.currentData()
            self.version_combo.blockSignals(True)
            self.version_combo.clear()
            for e in parse_releases(self._raw_releases, include_prereleases=self.show_pre.isChecked()):
                kind = e["channel"].upper() if e["prerelease"] else "STABLE"
                self.version_combo.addItem(f"{e['tag']}  ·  {kind}  ·  {e['published_at'][:10]}", e["tag"])
            idx = self.version_combo.findData(keep) if keep else -1
            self.version_combo.setCurrentIndex(max(idx, 0))
            self.version_combo.blockSignals(False)
            self._update_preview()

        def _on_version_picked(self) -> None:
            if not self.radios["version"].isChecked():
                self.radios["version"].setChecked(True)
            else:
                self._update_preview()

        def selected_release(self) -> dict[str, Any] | None:
            ch = self.selected_channel()
            if ch == "version":
                tag = self.version_combo.currentData()
                return find_release(self._raw_releases, tag) if tag else None
            return self._channels.get(ch)

        def _update_preview(self) -> None:
            ch = self.selected_channel()
            rel = self.selected_release()
            if not rel and ch == "version":
                self.install_btn.setEnabled(False)
                self.notes.setPlainText("Check Releases first, then pick a version.")
                return
            if not rel:
                self.install_btn.setEnabled(False)
                self.notes.setPlainText(
                    f"No dedicated '{ch}' release is currently posted on {REPO}.\n\n"
                    "Choose another channel or a specific version above."
                )
                return
            self.install_btn.setEnabled(self._family == "arch")
            a = rel["asset"]
            kind = "PRE-RELEASE" if rel["prerelease"] else "STABLE"
            self.notes.setPlainText(
                f"Channel : {ch.upper() if ch != 'version' else 'SPECIFIC VERSION'} ({kind})\n"
                f"Release : {rel['name']} ({rel['tag']})\n"
                f"Date    : {rel['published_at']}\n"
                f"Package : {a['name']} ({a['size'] / (1024*1024):.1f} MiB)\n"
                f"SHA-256 : {a['sha256'] or 'not published'}\n"
                f"URL     : {rel['html_url']}\n\n"
                f"--- Release Notes ---\n{rel['notes'] or '(no notes)'}"
            )

        def start_install(self) -> None:
            if self._family != "arch":
                self.status_lbl.setText(
                    "Upstream ships an Arch pacman package only. No .deb, .rpm, AppImage, or Flatpak in this beta."
                )
                return
            ch = self.selected_channel()
            rel = self.selected_release()
            if not rel:
                return
            if ch == "version":
                ch = "pre-release" if rel["prerelease"] else "stable"
            ans = QMessageBox.question(
                self,
                "Install Vibepollo",
                f"Download, verify SHA-256, and install:\n\n  {rel['name']} ({ch.upper()})\n  {rel['asset']['name']}\n\nProceed?",
            )
            if ans != QMessageBox.Yes:
                return
            self._run_worker(InstallWorker(rel=rel, parent=self))

        def start_rollback(self) -> None:
            path_str = self.rollback_combo.currentData()
            if not path_str:
                return
            pkg = Path(path_str)
            ans = QMessageBox.question(
                self,
                "Rollback Vibepollo",
                f"Reinstall cached package:\n\n  {pkg.name}\n\nProceed?",
            )
            if ans != QMessageBox.Yes:
                return
            self._run_worker(InstallWorker(rel=None, local_pkg=pkg, parent=self))

        def _on_progress(self, pct: int, message: str) -> None:
            self.pbar.setValue(pct)
            self.status_lbl.setText(message)

        def _run_worker(self, w: InstallWorker) -> None:
            if self._busy():
                self.status_lbl.setText("Still working. This window stays open until the job finishes.")
                return
            self.install_btn.setEnabled(False)
            self.rollback_btn.setEnabled(False)
            self.refresh_btn.setEnabled(False)
            self.pbar.setValue(0)
            self._adopt(w)
            w.progress.connect(self._on_progress, Qt.ConnectionType.QueuedConnection)
            w.finished_install.connect(self._on_install_done, Qt.ConnectionType.QueuedConnection)
            w.start()

        def _on_install_done(self, rc: int, out: str, pkg: Any) -> None:
            worker = self.sender()
            if isinstance(worker, QThread):
                worker.wait(60_000)
            self.refresh_btn.setEnabled(True)
            self._refresh_local_state()
            self._update_preview()
            self.notes.appendPlainText(f"\n--- pacman Output (exit {rc}) ---\n{out}")
            if rc == 0:
                self.pbar.setValue(100)
                self.status_lbl.setText(f"Installed vibepollo {installed_version()} successfully.")
                return
            safe_conflicts = filter_unowned_conflicts(parse_safe_vibepollo_conflicts(out))
            if safe_conflicts and isinstance(pkg, Path) and pkg.is_file():
                listing = "\n".join(f"  - {p}" for p in safe_conflicts)
                ans = QMessageBox.question(
                    self,
                    "Resolve Unowned Vibepollo File Conflict?",
                    "pacman reported untracked Vibepollo/Vibeshine file(s) not owned by any package:\n\n"
                    f"{listing}\n\n"
                    "This commonly happens when switching between Vibepollo Stable and Nightly.\n"
                    "Retry with scoped --overwrite for ONLY these exact unowned files?",
                )
                if ans == QMessageBox.Yes:
                    self._run_worker(
                        InstallWorker(rel=None, local_pkg=pkg, overwrite_paths=safe_conflicts, parent=self)
                    )
                    return
            self.status_lbl.setText(f"Install exited with code {rc} (see log above).")

    win = UpdaterWindow()
    if smoke_offscreen:
        class NopWorker(QThread):
            def run(self) -> None:
                self.msleep(50)

        nop = NopWorker(win)
        win._adopt(nop)
        nop.start()
        nop.wait(2_000)
        for _ in range(50):
            app.processEvents()
            if not win._live_workers:
                break
            QThread.msleep(10)
        if win._live_workers or win._busy():
            print("worker was not reaped on the GUI thread", file=sys.stderr)
            return 1
        app.processEvents()
        print(json.dumps({"ok": True, "version": __version__, "installed": installed_version(), "service": service_status()}))
        win.close()
        app.processEvents()
        return 0
    win.show()
    return app.exec()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version=f"vibepollo-updater {__version__}")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="show installed version vs Stable/Pre-release/Beta/Nightly")
    mode.add_argument("--list", action="store_true", help="list every release, pre-releases included")
    mode.add_argument("--install-version", metavar="TAG", help="download, verify SHA-256 & install one specific release (stable or pre-release)")
    mode.add_argument("--json", action="store_true", help="show release check output as JSON")
    mode.add_argument("--update", choices=CHANNELS, help="download, verify SHA-256 & install channel in CLI")
    mode.add_argument("--rollback", action="store_true", help="reinstall newest cached fallback package")
    mode.add_argument("--smoke-offscreen", action="store_true", help="headless Qt GUI verification")
    parser.add_argument("--stable-only", action="store_true", help="with --list, hide pre-releases")
    parser.add_argument("--overwrite-unowned", action="store_true", help="in CLI --update/--rollback, retry scoped --overwrite for unowned vibepollo/vibeshine file conflicts")
    ns = parser.parse_args(argv)

    if ns.check or ns.json:
        return cli_check(as_json=ns.json)
    if ns.list:
        return cli_list(include_prereleases=not ns.stable_only)
    if ns.update or ns.install_version:
        if linux_family() != "arch":
            print(
                "This distro has no upstream Vibepollo package. Linux beta ships an Arch pacman package only.",
                file=sys.stderr,
            )
            return 2
        if ns.install_version:
            rel = find_release(fetch_releases(), ns.install_version)
            if not rel:
                print(f"No installable release tagged '{ns.install_version}' on {REPO}. See --list.", file=sys.stderr)
                return 2
            retry = f"--install-version {rel['tag']}"
        else:
            rel = fetch_channels().get(ns.update)
            retry = f"--update {ns.update}"
            if not rel:
                print(f"No dedicated '{ns.update}' release is currently posted on {REPO}.", file=sys.stderr)
                return 2
        pkg = download_and_verify(rel, progress_cb=lambda p, m: print(f"[{p:3d}%] {m}"))
        rc, out = install_package(pkg, use_pkexec=False)
        if rc != 0:
            safe = filter_unowned_conflicts(parse_safe_vibepollo_conflicts(out))
            if safe and ns.overwrite_unowned:
                print(f"Retrying with scoped --overwrite for unowned Vibepollo files: {', '.join(safe)}")
                rc, out = install_package(pkg, use_pkexec=False, overwrite_paths=safe)
            elif safe:
                print(out)
                print(
                    f"\nHint: Unowned Vibepollo file conflict detected ({', '.join(safe)}).\n"
                    f"Re-run with: vibepollo-updater {retry} --overwrite-unowned",
                    file=sys.stderr,
                )
                return rc
        print(out)
        return rc
    if ns.rollback:
        cached = list_cached_packages()
        if not cached:
            print(f"No cached Vibepollo packages found in {CACHE_DIR}.", file=sys.stderr)
            return 2
        rc, out = install_package(cached[0], use_pkexec=False)
        print(out)
        return rc
    return launch_gui(smoke_offscreen=ns.smoke_offscreen)


if __name__ == "__main__":
    raise SystemExit(main())
